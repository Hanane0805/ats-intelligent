POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ats_db

OPENAI_API_KEY=sk-votre-cle-api-ici
GEMINI_API_KEY=votre-cle-gemini-ici

JWT_SECRET=votre-jwt-secret-ici
JWT_EXPIRATION=86400000

GOOGLE_CLIENT_ID=votre-google-client-id
GOOGLE_CLIENT_SECRET=votre-google-client-secret

# n8n - Automatisation des workflows
N8N_ENABLED=true
N8N_API_KEY=changez-moi-en-production
N8N_WEBHOOK_CANDIDATURE_CREATED=http://localhost:5678/webhook/candidature-created
N8N_WEBHOOK_CANDIDATURE_UPDATED=http://localhost:5678/webhook/candidature-updated

# Paramètres SMTP (Gmail) pour la 2FA
MAIL_USERNAME=votre.email@gmail.com
MAIL_PASSWORD=votre-mot-de-passe-d-application
